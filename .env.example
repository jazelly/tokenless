# Copy this file to .env and point it at a complete Tokenless config.
# The adjacent registry's default profile is the one persistent profile used by every browser test.
TOKENLESS_TEST_CONFIG=/absolute/path/to/tokenless-home/config.json

# Optional: make OpenAI-compatible API requests use the visible provider website
# when the caller does not send tokenless.execution_mode explicitly.
# TOKENLESS_API_PROXY_EXECUTION_MODE=browser
