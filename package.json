{
  "name": "tokenless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Standalone managed Playwright bridge for visible AI provider sessions.",
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build:scripts",
    "build:scripts": "node -e \"require('node:fs').rmSync('dist/scripts',{recursive:true,force:true})\" && tsc -p tsconfig.scripts.json",
    "changeset": "changeset",
    "lint": "npm run api:check && npm run lint --workspaces --if-present && tsc -p tsconfig.scripts.json --noEmit",
    "api:check": "node scripts/check-api-contract.mjs",
    "release:version": "node scripts/release/version.mjs",
    "prototype:cloakbrowser": "node scripts/prototypes/cloakbrowser-spike.mjs",
    "prototype:cloakbrowser-profile-compat": "node scripts/prototypes/cloakbrowser-profile-compat-spike.mjs",
    "sync:skill": "npm run build:scripts && node dist/scripts/sync-tokenless-skill.mjs",
    "test": "npm run build && node dist/scripts/test-all.mjs",
    "test:ts-daemon-conformance": "npm run build && node --test --test-concurrency=1 test/ts-daemon-conformance.test.mjs",
    "test:e2e": "npm run build && TOKENLESS_LIVE_E2E_GATE=all node --test --test-concurrency=1 test/live-managed-playwright.e2e.mjs",
    "test:e2e:non-submission": "TOKENLESS_LIVE_E2E_GATE=non_submission node --test --test-concurrency=1 test/live-managed-playwright.e2e.mjs",
    "test:e2e:mutation": "TOKENLESS_LIVE_E2E_GATE=mutation node --test --test-concurrency=1 test/live-managed-playwright.e2e.mjs",
    "test:e2e:project": "TOKENLESS_LIVE_E2E_GATE=project node --test --test-concurrency=1 test/live-managed-playwright.e2e.mjs",
    "test:e2e:fallback": "TOKENLESS_LIVE_FALLBACK_E2E_GATE=real-provider-fallback node --test --test-concurrency=1 test/live-provider-fallback.e2e.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "selfsigned": "^5.5.0",
    "typescript": "^7.0.2"
  }
}
