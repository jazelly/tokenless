{
  "schema": "tokenless.live-web-ui-fixtures.v1",
  "homes": {
    "dedicated": {
      "path": "~/.tokenless/e2e/live-provider"
    }
  },
  "profiles": {
    "cloak": {
      "home": "dedicated",
      "slug": "live-provider-cloak"
    }
  },
  "providers": {
    "chatgpt": {
      "id": "chatgpt"
    }
  },
  "startups": {
    "desktop-fresh": {
      "context": "fresh",
      "reload": false,
      "viewport": { "width": 1920, "height": 1080 }
    },
    "desktop-reload": {
      "context": "shared",
      "reload": true,
      "viewport": { "width": 1920, "height": 1080 }
    },
    "mobile-fresh": {
      "context": "fresh",
      "reload": false,
      "viewport": { "width": 390, "height": 844 }
    }
  },
  "cases": {
    "cloak-chatgpt-desktop": {
      "profile": "cloak",
      "provider": "chatgpt",
      "startup": "desktop-fresh"
    },
    "cloak-chatgpt-reload": {
      "profile": "cloak",
      "provider": "chatgpt",
      "startup": "desktop-reload"
    },
    "cloak-chatgpt-mobile": {
      "profile": "cloak",
      "provider": "chatgpt",
      "startup": "mobile-fresh"
    }
  },
  "suites": {
    "representative-provider": [
      "cloak-chatgpt-desktop",
      "cloak-chatgpt-reload",
      "cloak-chatgpt-mobile"
    ]
  }
}
