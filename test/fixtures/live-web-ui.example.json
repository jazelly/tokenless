{
  "schema": "tokenless.live-web-ui-fixtures.v1",
  "homes": {
    "main": {
      "path": "~/.tokenless"
    }
  },
  "profiles": {
    "work": {
      "home": "main",
      "slug": "work"
    }
  },
  "providers": {
    "chatgpt": {
      "id": "chatgpt"
    }
  },
  "startups": {
    "desktop-fresh": {
      "context": "fresh",
      "reload": false,
      "viewport": {
        "width": 1920,
        "height": 1080
      }
    },
    "desktop-reload": {
      "context": "shared",
      "reload": true,
      "viewport": {
        "width": 1920,
        "height": 1080
      }
    },
    "mobile-fresh": {
      "context": "fresh",
      "reload": false,
      "viewport": {
        "width": 390,
        "height": 844
      }
    }
  },
  "cases": {
    "work-chatgpt-desktop": {
      "profile": "work",
      "provider": "chatgpt",
      "startup": "desktop-fresh"
    },
    "work-chatgpt-reload": {
      "profile": "work",
      "provider": "chatgpt",
      "startup": "desktop-reload"
    },
    "work-chatgpt-mobile": {
      "profile": "work",
      "provider": "chatgpt",
      "startup": "mobile-fresh"
    }
  },
  "suites": {
    "smoke": [
      "work-chatgpt-desktop"
    ],
    "startup-matrix": [
      "work-chatgpt-desktop",
      "work-chatgpt-reload",
      "work-chatgpt-mobile"
    ]
  }
