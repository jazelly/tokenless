{
  "name": "tokenless-internal-server",
  "version": "0.0.0",
  "private": true,
  "description": "Private Tokenless daemon, HTTP, provider, browser, and persistence runtime.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": "./dist/src/*"
  },
  "imports": {
    "#tokenless-shared/*": "tokenless-internal-shared/*"
  },
  "scripts": {
    "build": "tsc -b ../shared && node scripts/build.mjs",
    "lint": "tsc -b ../shared && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "impers": "0.1.0",
    "playwright-core": "1.61.1",
    "tokenless-internal-shared": "0.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "vite": "8.2.0"
  }
}
