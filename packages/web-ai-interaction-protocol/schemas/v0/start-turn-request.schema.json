{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenless-internal:web-ai-interaction-protocol:v0:start-turn-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestRef", "providerRef", "providerBindingRef", "requiredCapabilities", "conversation", "bootstrap"],
  "properties": {
    "protocol": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/protocol" },
    "requestRef": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/requestRef" },
    "providerRef": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/providerRef" },
    "providerBindingRef": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/providerBindingRef" },
    "requiredCapabilities": {
      "type": "array",
      "prefixItems": [{ "const": "conversation.chat" }, { "const": "file.upload" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "new" } }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "attachments"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 4000, "x-tokenless-internal-maxUtf8Bytes": 8192 },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "attachmentRef", "mediaType", "byteLength", "sha256"],
            "properties": {
              "kind": { "const": "system_prompt" },
              "attachmentRef": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/attachmentRef" },
              "mediaType": { "const": "text/markdown" },
              "byteLength": { "type": "integer", "minimum": 1, "maximum": 1048576 },
              "sha256": { "$ref": "urn:tokenless-internal:web-ai-interaction-protocol:v0:common#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
