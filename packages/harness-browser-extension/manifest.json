{
  "manifest_version": 3,
  "name": "Tokenless Harness",
  "version": "0.1.0",
  "description": "Tokenless Harness / Tokenless Harness：在用户明确选择的 Chrome 页面上观察并填写普通文本字段。",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:7331/*"
  ],
  "action": {
    "default_title": "Tokenless Harness / Tokenless Harness"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
