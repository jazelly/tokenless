{
  "manifest_version": 3,
  "name": "Tokenless Harness",
  "version": "0.2.0",
  "description": "Tokenless Harness: performs per-action-approved form operations on Chrome pages the user explicitly selects.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:7331/*"
  ],
  "action": {
    "default_title": "Tokenless Harness"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
