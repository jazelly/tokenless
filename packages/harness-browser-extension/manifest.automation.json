{
  "manifest_version": 3,
  "name": "Tokenless Harness (Automation Test)",
  "version": "0.2.0",
  "description": "Local automation-test build only. Not the release candidate. Grants standing host permission to the whitelisted test page so scripted runs do not need a manual click.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7331/*",
    "https://au-lrn.assessapp.com/*",
    "https://salfordcollege.assessapp.com/*"
  ],
  "action": {
    "default_title": "Tokenless Harness (Automation Test)"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
