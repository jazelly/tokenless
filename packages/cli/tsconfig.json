{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "#tokenless-shared/*": ["../shared/dist/src/*"],
      "#tokenless-server/*": ["../server/dist/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "references": [{ "path": "../shared" }, { "path": "../server" }]
}
