{
  "name": "tokenless",
  "version": "0.6.0",
  "description": "Tokenless CLI for managed Playwright access to visible AI provider sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazelly/tokenless.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "imports": {
    "#tokenless-shared/*": "./dist/shared/src/*",
    "#tokenless-server/*": "./dist/server/src/*",
    "#tokenless-harness/*": "./dist/harness/src/*"
  },
  "files": [
    "dist/integrations",
    "dist/src",
    "dist/server",
    "dist/schemas",
    "dist/harness",
    "dist/shared",
    "dist/runtime",
    "README.md",
    "README.zh-CN.md",
    "package.json"
  ],
  "bin": {
    "tokenless": "dist/src/tokenless.mjs"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "lint": "tsc -b ../server && tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/build-package.mjs"
  },
  "dependencies": {
    "impers": "0.1.0",
    "playwright-core": "1.61.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "vite": "8.2.0"
  }
}
