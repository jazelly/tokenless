{
  "name": "tokenless",
  "version": "0.4.1",
  "description": "Tokenless CLI for managed Playwright access to visible AI provider sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazelly/tokenless.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "package.json"
  ],
  "bin": {
    "tokenless": "dist/src/tokenless.mjs"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.ui.json",
    "prepack": "node scripts/build-package.mjs"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@lucide/svelte": "1.28.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "vite": "8.2.0"
  }
}
