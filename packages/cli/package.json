{
  "name": "tokenless",
  "version": "0.3.0",
  "description": "Tokenless CLI for managed Playwright access to visible AI provider sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazelly/tokenless.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "package.json"
  ],
  "bin": {
    "tokenless": "dist/src/tokenless.mjs"
  },
  "scripts": {
    "build": "npm run build:js",
    "build:js": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('node:fs'); fs.chmodSync('dist/src/tokenless.mjs',0o755); fs.chmodSync('dist/src/daemon/daemon-entry.mjs',0o755)\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build:js"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
