{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenless.dev/protocol/schemas/runner-heartbeat.v2.schema.json",
  "title": "Tokenless managed Playwright runner heartbeat v2",
  "type": "object",
  "required": [
    "protocol",
    "session_id",
    "pid",
    "observed_at",
    "expires_at",
    "accepts",
    "emits"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "tokenless.playwright.runner-heartbeat.v2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepts": {
      "$ref": "#/$defs/protocolList"
    },
    "emits": {
      "$ref": "#/$defs/protocolList"
    }
  },
  "$defs": {
    "protocolList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tokenless\\.[a-z0-9.-]+\\.v\\d+$"
      },
      "uniqueItems": true
    }
  }
}
