{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenless.dev/protocol/schemas/playwright-job.v2.schema.json",
  "title": "Tokenless managed Playwright job request v2",
  "type": "object",
  "required": ["protocol", "provider", "target", "taskId", "browserVisibility", "actions"],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "tokenless.playwright.job.v2"
    },
    "provider": {
      "$ref": "#/$defs/providerId"
    },
    "target": {
      "$ref": "#/$defs/providerHomeTarget"
    },
    "taskId": {
      "$ref": "#/$defs/taskId"
    },
    "browserVisibility": {
      "enum": ["auto", "headed", "headless"]
    },
    "actions": {
      "$ref": "#/$defs/actionList"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "chatgpt"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://(?:chatgpt\\.com|chat\\.openai\\.com)(?:/[^?#]*)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "claude"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://claude\\.ai(?:/[^?#]*)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "gemini"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://gemini\\.google\\.com(?:/[^?#]*)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "grok"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://grok\\.com(?:/[^?#]*)?$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "providerId": {
      "enum": ["chatgpt", "claude", "gemini", "grok"]
    },
    "providerHomeTarget": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "provider_home"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:chatgpt\\.com|chat\\.openai\\.com|claude\\.ai|gemini\\.google\\.com|grok\\.com)(?:/[^?#]*)?$"
        }
      }
    },
    "taskId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-tokenless-maxUtf8Bytes": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      ]
    },
    "actionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "$ref": "https://tokenless.dev/protocol/schemas/visible-action.v1.schema.json"
          },
          {
            "$ref": "https://tokenless.dev/protocol/schemas/visible-action.v2.schema.json"
          }
        ]
      }
    }
  }
}
