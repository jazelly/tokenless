{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenless.dev/protocol/schemas/playwright-job.v3.schema.json",
  "title": "Tokenless managed Playwright job request v3",
  "type": "object",
  "required": ["protocol", "provider", "target", "taskId", "browserVisibility", "actions"],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "tokenless.playwright.job.v3"
    },
    "provider": {
      "$ref": "#/$defs/providerId"
    },
    "target": {
      "$ref": "#/$defs/providerHomeTarget"
    },
    "taskId": {
      "$ref": "#/$defs/taskId"
    },
    "browserVisibility": {
      "enum": ["auto", "headed", "headless"]
    },
    "actions": {
      "$ref": "#/$defs/actionList"
    }
  },
  "$defs": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "providerHomeTarget": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "provider_home"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "x-tokenless-maxUtf8Bytes": 2048,
          "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z][a-z0-9-]{0,61}(?:/[^?#]*)?$"
        }
      }
    },
    "taskId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-tokenless-maxUtf8Bytes": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      ]
    },
    "actionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://tokenless.dev/protocol/schemas/visible-action.v3.schema.json"
      }
    }
  }
}
