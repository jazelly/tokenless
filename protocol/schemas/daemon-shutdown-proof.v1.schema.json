{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenless.dev/protocol/schemas/daemon-shutdown-proof.v1.schema.json",
  "title": "Tokenless daemon shutdown proof v1",
  "description": "A one-request HMAC-SHA256 proof over an ordered length-prefixed tuple: protocol, the short-lived single-use server-issued challenge from a verified /ready response, method, path, canonical home, pid, instance id, and running binary SHA-256. Each UTF-8 field is prefixed by its 4-byte unsigned big-endian byte length.",
  "type": "object",
  "required": [
    "protocol",
    "challenge",
    "home_dir",
    "pid",
    "instance_id",
    "running_binary_hash",
    "proof"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "tokenless.daemon-shutdown-proof.v1"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "home_dir": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "running_binary_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
