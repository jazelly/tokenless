{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenless.dev/protocol/schemas/daemon-error.v1.schema.json",
  "title": "Tokenless daemon error envelope v1",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["protocol", "code", "message", "retryable"],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "tokenless.daemon.error.v1"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
