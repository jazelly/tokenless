{
  "openapi": "3.1.0",
  "info": {
    "title": "Tokenless daemon HTTP API",
    "version": "1.0.0",
    "description": "Local loopback daemon HTTP API governed by tokenless.daemon.v1. Every daemon route, readiness proof, error envelope, job payload, and browser runtime control response belongs to this OpenAPI contract; in-process TypeScript runtime modules do not negotiate separate wire protocols."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7331"
    }
  ],
  "security": [
    {
      "controlBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Read daemon health without auth",
        "security": [],
        "responses": {
          "200": {
            "description": "Daemon health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "summary": "Read token-bound daemon readiness proof without auth",
        "security": [],
        "parameters": [
          {
            "name": "challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daemon readiness proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/browser-runtime/status": {
      "get": {
        "operationId": "getBrowserRuntimeStatus",
        "summary": "Read embedded browser runtime status",
        "responses": {
          "200": {
            "description": "Browser runtime status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserRuntimeStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/browser-runtime/quiesce": {
      "post": {
        "operationId": "quiesceBrowserRuntime",
        "summary": "Quiesce the embedded browser runtime",
        "responses": {
          "200": {
            "description": "Browser runtime status after quiesce request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserRuntimeStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List public job views",
        "parameters": [
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/execution_backend"
          },
          {
            "$ref": "#/components/parameters/profile_id"
          },
          {
            "$ref": "#/components/parameters/provider"
          },
          {
            "$ref": "#/components/parameters/task_id"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobView"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createJob",
        "summary": "Create a job and return its private claim token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created job with claim token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobWithClaimToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Read a public job view",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/claim": {
      "post": {
        "operationId": "claimJob",
        "summary": "Claim a queued job with its claim token",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/ClaimToken"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/complete": {
      "post": {
        "operationId": "completeJob",
        "summary": "Complete a claimed job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/resume": {
      "post": {
        "operationId": "resumeJob",
        "summary": "Resume a parked Playwright job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/claim-next": {
      "post": {
        "operationId": "claimNextJob",
        "summary": "Claim the next queued job for a worker scope",
        "parameters": [
          {
            "$ref": "#/components/parameters/execution_backend"
          },
          {
            "$ref": "#/components/parameters/profile_id"
          },
          {
            "$ref": "#/components/parameters/provider"
          },
          {
            "$ref": "#/components/parameters/action"
          }
        ],
        "responses": {
          "200": {
            "description": "Next matching job, or null when the queue is empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimNextResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/checkpoint": {
      "post": {
        "operationId": "checkpointJob",
        "summary": "Persist private Playwright checkpoint state",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckpointJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/park": {
      "post": {
        "operationId": "parkJob",
        "summary": "Park a Playwright job for user handover",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/running": {
      "post": {
        "operationId": "markJobRunning",
        "summary": "Mark a claimed or waiting job as running",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/ClaimToken"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/waiting-for-user": {
      "post": {
        "operationId": "markJobWaitingForUser",
        "summary": "Mark a running job as waiting for user handover",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitingForUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/renew": {
      "post": {
        "operationId": "renewJobClaim",
        "summary": "Renew an active job claim lease",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/ClaimToken"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "summary": "Cancel an active job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/shutdown": {
      "post": {
        "operationId": "shutdownDaemon",
        "summary": "Request graceful daemon shutdown using bearer authentication",
        "security": [
          {
            "controlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Shutdown accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShutdownResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Shutdown route is not mounted by runtimes that use http_router(store); Axum may return its default 404 body."
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token read from the daemon home control token file. /health and /ready are public challenge endpoints; /control/shutdown uses bearer authentication after the CLI verifies /ready for the same home."
      }
    },
    "parameters": {
      "job_id": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/JobStatus"
        }
      },
      "execution_backend": {
        "name": "execution_backend",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/ExecutionBackend"
        }
      },
      "profile_id": {
        "name": "profile_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "provider": {
        "name": "provider",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "task_id": {
        "name": "task_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "action": {
        "name": "action",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      }
    },
    "requestBodies": {
      "ClaimToken": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ClaimTokenRequest"
            }
          }
        }
      }
    },
    "responses": {
      "PublicJob": {
        "description": "Public job view",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JobView"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request body, path, query, or daemon input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Rejected bearer token or claim token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Job or routed endpoint not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Claim lease or job state conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Daemon internal failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "DaemonErrorResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DaemonErrorEnvelopeV1"
          },
          {
            "$ref": "#/components/schemas/LegacyDaemonErrorEnvelope"
          }
        ]
      },
      "DaemonErrorEnvelopeV1": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "protocol",
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false,
            "properties": {
              "protocol": {
                "const": "tokenless.daemon.v1"
              },
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "LegacyDaemonErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message"
            ],
            "additionalProperties": true,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "protocol",
          "version",
          "runtime_kind",
          "status",
          "ready",
          "home_dir",
          "pid"
        ],
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "const": "tokenless.daemon.v1"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "runtime_kind": {
            "const": "typescript"
          },
          "status": {
            "const": "ok"
          },
          "ready": {
            "const": true
          },
          "home_dir": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ReadyResponse": {
        "type": "object",
        "required": [
          "protocol",
          "version",
          "runtime_kind",
          "status",
          "ready",
          "home_dir",
          "pid",
          "ready_challenge",
          "ready_proof",
          "supported_providers"
        ],
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "const": "tokenless.daemon.v1"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "runtime_kind": {
            "const": "typescript"
          },
          "status": {
            "const": "ok"
          },
          "ready": {
            "const": true
          },
          "home_dir": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "ready_challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "ready_proof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "supported_providers": {
            "$ref": "#/components/schemas/SupportedProviders"
          }
        }
      },
      "SupportedProviders": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "BrowserRuntimeStatus": {
        "type": "object",
        "required": [
          "protocol",
          "status",
          "activeProfileCount",
          "activeJobCount",
          "pid"
        ],
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "const": "tokenless.daemon.v1"
          },
          "status": {
            "enum": [
              "running",
              "quiescing",
              "quiesced",
              "stopped"
            ]
          },
          "activeProfileCount": {
            "type": "integer",
            "minimum": 0
          },
          "activeJobCount": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ExecutionBackend": {
        "enum": [
          "legacy_extension",
          "playwright"
        ]
      },
      "JobStatus": {
        "enum": [
          "queued",
          "claimed",
          "running",
          "waiting_for_user",
          "succeeded",
          "failed",
          "canceled",
          "timed_out"
        ]
      },
      "JobView": {
        "type": "object",
        "required": [
          "job_id",
          "execution_backend",
          "profile_id",
          "provider",
          "action",
          "status",
          "request_json",
          "result_json",
          "error_json",
          "blocker_json",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_backend": {
            "$ref": "#/components/schemas/ExecutionBackend"
          },
          "profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "request_json": {},
          "result_json": {},
          "error_json": {},
          "blocker_json": {},
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobWithClaimToken": {
        "type": "object",
        "required": [
          "job_id",
          "claim_token",
          "execution_backend",
          "profile_id",
          "provider",
          "action",
          "status",
          "request_json",
          "result_json",
          "error_json",
          "blocker_json",
          "checkpoint_json",
          "resume_json",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_token": {
            "type": "string",
            "minLength": 1
          },
          "execution_backend": {
            "$ref": "#/components/schemas/ExecutionBackend"
          },
          "profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "request_json": {},
          "result_json": {},
          "error_json": {},
          "blocker_json": {},
          "checkpoint_json": {},
          "resume_json": {},
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "required": [
          "provider",
          "action",
          "request_json"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "request_json": {},
          "execution_backend": {
            "$ref": "#/components/schemas/ExecutionBackend"
          },
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_token": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ClaimTokenRequest": {
        "type": "object",
        "required": [
          "claim_token"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CompleteJobRequest": {
        "type": "object",
        "required": [
          "claim_token"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1
          },
          "result_json": {},
          "error_json": {}
        },
        "oneOf": [
          {
            "required": [
              "result_json"
            ],
            "not": {
              "required": [
                "error_json"
              ]
            }
          },
          {
            "required": [
              "error_json"
            ],
            "not": {
              "required": [
                "result_json"
              ]
            }
          }
        ]
      },
      "ResumeJobRequest": {
        "type": "object",
        "required": [
          "browser_visibility"
        ],
        "additionalProperties": false,
        "properties": {
          "browser_visibility": {
            "const": "headed"
          }
        }
      },
      "WaitingForUserRequest": {
        "type": "object",
        "required": [
          "claim_token",
          "blocker_json"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1
          },
          "blocker_json": {}
        }
      },
      "CheckpointJobRequest": {
        "type": "object",
        "required": [
          "claim_token",
          "checkpoint_json"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint_json": {}
        }
      },
      "ParkJobRequest": {
        "type": "object",
        "required": [
          "claim_token",
          "blocker_json",
          "checkpoint_json"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1
          },
          "blocker_json": {},
          "checkpoint_json": {}
        }
      },
      "CancelJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {}
        }
      },
      "ClaimNextResponse": {
        "type": "object",
        "required": [
          "job"
        ],
        "additionalProperties": false,
        "properties": {
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobWithClaimToken"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ShutdownResponse": {
        "type": "object",
        "required": [
          "ok",
          "status",
          "pid"
        ],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": true
          },
          "status": {
            "const": "shutting_down"
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
