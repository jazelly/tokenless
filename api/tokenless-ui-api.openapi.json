{
  "openapi": "3.1.0",
  "info": {
    "title": "Tokenless Browser UI API",
    "version": "1.0.0",
    "description": "Authenticated, loopback-only API consumed by the bundled Tokenless control plane. Browser JavaScript never receives the daemon bearer token."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/ui-api/v1",
      "variables": { "port": { "default": "7331" } }
    }
  ],
  "security": [{ "uiSession": [] }],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getUiSession",
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "getUiSnapshot",
        "parameters": [
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Snapshot" },
          "304": { "description": "Snapshot revision is unchanged." },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/browser-runtimes": {
      "get": {
        "operationId": "listUiBrowserRuntimes",
        "responses": {
          "200": { "$ref": "#/components/responses/BrowserRuntimeCatalog" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/browser-runtimes/inspect": {
      "post": {
        "operationId": "inspectUiBrowserRuntime",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/BrowserRuntimeInspect" },
        "responses": {
          "200": { "$ref": "#/components/responses/BrowserRuntimeInspection" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/browser-runtimes/install": {
      "post": {
        "operationId": "installUiBrowserRuntime",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/BrowserRuntimeInstall" },
        "responses": {
          "200": { "$ref": "#/components/responses/BrowserRuntime" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/browser-profile-sources/discover": {
      "post": {
        "operationId": "discoverUiBrowserProfileSources",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/BrowserProfileDiscovery" },
        "responses": {
          "200": { "$ref": "#/components/responses/BrowserProfileSources" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/config": {
      "patch": {
        "operationId": "updateUiConfig",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ConfigUpdate" },
        "responses": {
          "200": { "$ref": "#/components/responses/Config" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/output-savings/enable": {
      "post": {
        "operationId": "enableUiOutputSavings",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/EmptyObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/OutputSavingsState" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/output-savings/disable": {
      "post": {
        "operationId": "disableUiOutputSavings",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/EmptyObject" },
        "responses": { "200": { "$ref": "#/components/responses/OutputSavingsState" } }
      }
    },
    "/output-savings/runtime/uninstall": {
      "post": {
        "operationId": "uninstallUiOutputSavingsRuntime",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ConfirmedDeletion" },
        "responses": {
          "200": { "$ref": "#/components/responses/OutputSavingsState" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/output-savings/history/clear": {
      "post": {
        "operationId": "clearUiOutputSavingsHistory",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ConfirmedDeletion" },
        "responses": {
          "200": { "$ref": "#/components/responses/OutputSavingsState" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/profiles": {
      "post": {
        "operationId": "createUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileCreate" },
        "responses": {
          "201": { "$ref": "#/components/responses/Profile" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/profiles/{profileId}": {
      "parameters": [{ "$ref": "#/components/parameters/ProfileId" }],
      "patch": {
        "operationId": "updateUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileUpdate" },
        "responses": { "200": { "$ref": "#/components/responses/Profile" }, "400": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "removeUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "responses": { "200": { "$ref": "#/components/responses/ProfileRemoval" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/open": {
      "post": {
        "operationId": "openUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProfileId" }],
        "responses": { "200": { "$ref": "#/components/responses/RuntimeOpen" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/reimport": {
      "post": {
        "operationId": "reimportUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProfileId" }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileReimport" },
        "responses": { "200": { "$ref": "#/components/responses/Profile" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/providers/{providerId}/actions/{action}": {
      "post": {
        "operationId": "runUiProviderAction",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProfileId" },
          { "$ref": "#/components/parameters/ProviderId" },
          { "name": "action", "in": "path", "required": true, "schema": { "type": "string", "enum": ["open", "readiness", "controls"] } }
        ],
        "responses": { "202": { "$ref": "#/components/responses/JobSummary" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/providers/{providerId}/selection": {
      "post": {
        "operationId": "selectUiProviderControl",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProfileId" },
          { "$ref": "#/components/parameters/ProviderId" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ProviderSelection" },
        "responses": { "202": { "$ref": "#/components/responses/JobSummary" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getUiJob",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/cancel": {
      "post": {
        "operationId": "cancelUiJob",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/resume": {
      "post": {
        "operationId": "resumeUiJob",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/runtime/quiesce": {
      "post": {
        "operationId": "quiesceUiRuntime",
        "security": [{ "uiSession": [], "csrf": [] }],
        "responses": { "200": { "$ref": "#/components/responses/RuntimeOperation" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "uiSession": { "type": "apiKey", "in": "cookie", "name": "tokenless_ui_session" },
      "csrf": { "type": "apiKey", "in": "header", "name": "X-Tokenless-CSRF" }
    },
    "parameters": {
      "ProfileId": { "name": "profileId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ProfileId" } },
      "ProviderId": { "name": "providerId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ProviderId" } },
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "requestBodies": {
      "EmptyObject": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false } } } },
      "ConfirmedDeletion": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfirmedDeletion" } } } },
      "ConfigUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigUpdate" } } } },
      "BrowserRuntimeInspect": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserRuntimeInspect" } } } },
      "BrowserRuntimeInstall": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserRuntimeInstall" } } } },
      "BrowserProfileDiscovery": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserProfileDiscovery" } } } },
      "ProfileCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileCreate" } } } },
      "ProfileUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileUpdate" } } } },
      "ProfileReimport": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileReimport" } } } },
      "ProviderSelection": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderSelection" } } } }
    },
    "responses": {
      "Session": { "description": "Active in-memory UI session.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiSession" } } } },
      "Snapshot": { "description": "Redacted aggregate dashboard state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiSnapshot" } } } },
      "Config": { "description": "Persisted public configuration.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiConfig" } } } },
      "OutputSavingsState": { "description": "Optional local output savings measurement state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutputSavingsState" } } } },
      "BrowserRuntimeCatalog": { "description": "Discovered and installable browser runtime choices.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserRuntimeCatalog" } } } },
      "BrowserRuntime": { "description": "Validated browser runtime metadata without a private executable path.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserRuntime" } } } },
      "BrowserRuntimeInspection": { "description": "Non-mutating browser validation result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserRuntimeInspection" } } } },
      "BrowserProfileSources": { "description": "Redacted browser profile sources selected by an opaque server-side identifier.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrowserProfileSources" } } } },
      "Profile": { "description": "Purpose-built managed profile view.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } },
      "ProfileRemoval": { "description": "Profile removal acknowledgement.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileRemoval" } } } },
      "JobSummary": { "description": "Redacted durable job summary.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobSummary" } } } },
      "JobDetail": { "description": "Redacted durable job detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobDetail" } } } },
      "RuntimeOpen": { "description": "Managed profile browser open result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeOpenResult" } } } },
      "RuntimeOperation": { "description": "Browser runtime operation result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeStatus" } } } },
      "Error": { "description": "Redacted error envelope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "ProfileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "ProviderId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "BrowserVisibility": { "type": "string", "enum": ["auto", "headed", "headless"] },
      "BrowserSelection": { "type": "string", "enum": ["auto", "chrome", "brave", "edge", "arc", "chromium", "chrome-for-testing", "managed-chromium", "cloak"] },
      "BrowserRuntimeOption": {
        "type": "object",
        "properties": {
          "selection": { "$ref": "#/components/schemas/BrowserSelection" },
          "displayName": { "type": "string" },
          "family": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "installed": { "type": "boolean" },
          "available": { "type": "boolean" },
          "downloadRequired": { "type": "boolean" },
          "customPathAllowed": { "type": "boolean" },
          "selected": { "type": "boolean" }
        },
        "required": ["selection", "displayName", "family", "version", "source", "installed", "available", "downloadRequired", "customPathAllowed", "selected"],
        "additionalProperties": false
      },
      "BrowserRuntimeCatalog": {
        "type": "object",
        "properties": {
          "selected": { "$ref": "#/components/schemas/BrowserSelection" },
          "browserExecutablePathConfigured": { "type": "boolean" },
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/BrowserRuntimeOption" } }
        },
        "required": ["selected", "browserExecutablePathConfigured", "options"],
        "additionalProperties": false
      },
      "BrowserRuntime": {
        "type": "object",
        "properties": {
          "selection": { "$ref": "#/components/schemas/BrowserSelection" },
          "runtimeId": { "type": "string" },
          "family": { "type": "string" },
          "browserId": { "type": "string" },
          "displayName": { "type": "string" },
          "platform": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string" },
          "managed": { "type": "boolean" },
          "checksumVerified": { "type": ["boolean", "null"] }
        },
        "required": ["selection", "runtimeId", "family", "browserId", "displayName", "platform", "version", "source", "managed", "checksumVerified"],
        "additionalProperties": false
      },
      "BrowserRuntimeInspection": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "runtime": { "anyOf": [{ "$ref": "#/components/schemas/BrowserRuntime" }, { "type": "null" }] },
          "code": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] }
        },
        "required": ["ok", "runtime", "code", "message"],
        "additionalProperties": false
      },
      "BrowserRuntimeInspect": {
        "type": "object",
        "properties": {
          "browser": { "$ref": "#/components/schemas/BrowserSelection" },
          "browserExecutablePath": { "type": ["string", "null"], "minLength": 1 }
        },
        "required": ["browser"],
        "additionalProperties": false
      },
      "BrowserRuntimeInstall": {
        "type": "object",
        "properties": {
          "browser": { "type": "string", "enum": ["managed-chromium", "cloak"] },
          "repair": { "type": "boolean" }
        },
        "required": ["browser"],
        "additionalProperties": false
      },
      "BrowserProfileDiscovery": {
        "type": "object",
        "properties": {
          "browser": { "type": "string", "enum": ["chrome", "brave", "edge", "arc", "chromium", "chrome-for-testing"] },
          "userDataDir": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      },
      "BrowserProfileSource": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "browser": { "type": "string", "enum": ["chrome", "brave", "edge", "arc", "chromium", "chrome-for-testing"] },
          "browserLabel": { "type": "string" },
          "directoryKey": { "type": "string" },
          "name": { "type": "string" },
          "browserVersion": { "type": ["string", "null"] },
          "compatible": { "type": "boolean" }
        },
        "required": ["id", "browser", "browserLabel", "directoryKey", "name", "browserVersion", "compatible"],
        "additionalProperties": false
      },
      "BrowserProfileSources": {
        "type": "object",
        "properties": {
          "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/BrowserProfileSource" } }
        },
        "required": ["sources"],
        "additionalProperties": false
      },
      "Proxy": {
        "type": ["object", "null"],
        "properties": {
          "server": { "type": "string", "format": "uri", "pattern": "^(?:https?|socks5)://" },
          "bypass": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["server", "bypass"],
        "additionalProperties": false
      },
      "ProfilePreferences": {
        "type": "object",
        "properties": {
          "profileId": { "$ref": "#/components/schemas/ProfileId" },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" }
        },
        "required": ["profileId", "roleLabel", "enabledProviders", "browserVisibility", "proxy"],
        "additionalProperties": false
      },
      "UiConfig": {
        "type": "object",
        "properties": {
          "updatedAt": { "type": ["string", "null"], "format": "date-time" },
          "providerWhitelist": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "browser": { "type": "string" },
          "browserExecutablePathConfigured": { "type": "boolean" },
          "browserConnectionMode": { "type": "string", "enum": ["playwright", "cdp"] },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "daemonUrl": { "type": ["string", "null"], "format": "uri" },
          "language": { "type": "string", "enum": ["en", "zh-CN"] },
          "outputSavings": {
            "type": "object",
            "properties": { "enabled": { "type": "boolean" } },
            "required": ["enabled"],
            "additionalProperties": false
          }
        },
        "required": ["updatedAt", "providerWhitelist", "browser", "browserExecutablePathConfigured", "browserConnectionMode", "browserVisibility", "daemonUrl", "language", "outputSavings"],
        "additionalProperties": false
      },
      "ConfirmedDeletion": {
        "type": "object",
        "properties": { "confirmDelete": { "const": true } },
        "required": ["confirmDelete"],
        "additionalProperties": false
      },
      "OutputSavingsRuntime": {
        "type": "object",
        "properties": {
          "runtimeId": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["not_installed", "invalid", "ready"] },
          "installed": { "type": "boolean" },
          "downloadBytes": { "type": "integer", "minimum": 0 },
          "installedBytes": { "type": "integer", "minimum": 0 },
          "checksumVerified": { "const": true },
          "selfTestVerified": { "const": true }
        },
        "required": ["runtimeId", "state", "installed", "downloadBytes", "installedBytes"],
        "additionalProperties": false
      },
      "OutputSavingsSummary": {
        "type": "object",
        "properties": {
          "estimatedOutputTokens": { "type": "integer", "minimum": 0 },
          "visibleCharacters": { "type": "integer", "minimum": 0 },
          "responseCount": { "type": "integer", "minimum": 0 },
          "jobCount": { "type": "integer", "minimum": 0 },
          "firstMeasuredAt": { "type": ["string", "null"], "format": "date-time" },
          "lastMeasuredAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["estimatedOutputTokens", "visibleCharacters", "responseCount", "jobCount", "firstMeasuredAt", "lastMeasuredAt"],
        "additionalProperties": false
      },
      "OutputSavingsState": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "collection": { "type": "string", "enum": ["disabled", "enabled", "unavailable"] },
          "estimator": { "const": "o200k_base" },
          "basis": { "const": "visible_assistant_text" },
          "runtime": { "$ref": "#/components/schemas/OutputSavingsRuntime" },
          "summary": { "$ref": "#/components/schemas/OutputSavingsSummary" },
          "cleared": { "type": "integer", "minimum": 0 }
        },
        "required": ["enabled", "collection", "estimator", "basis", "runtime", "summary"],
        "additionalProperties": false
      },
      "JobOutputSavings": {
        "type": "object",
        "properties": {
          "estimatedOutputTokens": { "type": "integer", "minimum": 0 },
          "visibleCharacters": { "type": "integer", "minimum": 0 },
          "responseCount": { "type": "integer", "minimum": 0 }
        },
        "required": ["estimatedOutputTokens", "visibleCharacters", "responseCount"],
        "additionalProperties": false
      },
      "OutputSavingsEvent": {
        "type": "object",
        "properties": {
          "responseRequestId": { "type": "string", "minLength": 1 },
          "estimatedOutputTokens": { "type": "integer", "minimum": 0 },
          "visibleCharacters": { "type": "integer", "minimum": 0 },
          "estimator": { "type": "string", "minLength": 1 },
          "estimatorRevision": { "type": "string", "minLength": 1 },
          "basis": { "const": "visible_assistant_text" },
          "measuredAt": { "type": "string", "format": "date-time" }
        },
        "required": ["responseRequestId", "estimatedOutputTokens", "visibleCharacters", "estimator", "estimatorRevision", "basis", "measuredAt"],
        "additionalProperties": false
      },
      "RuntimeStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "activeProfileCount": { "type": "integer", "minimum": 0, "maximum": 4 },
          "activeJobCount": { "type": "integer", "minimum": 0 },
          "pid": { "type": "integer", "minimum": 1 }
        },
        "required": ["status", "activeProfileCount", "activeJobCount", "pid"],
        "additionalProperties": true
      },
      "DaemonStatus": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "origin": { "type": "string", "format": "uri" },
          "uptimeMs": { "type": "integer", "minimum": 0 },
          "pid": { "type": "integer", "minimum": 1 }
        },
        "required": ["version", "origin", "uptimeMs", "pid"],
        "additionalProperties": false
      },
      "RuntimeOpenResult": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "format": "uuid" },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "effectiveBrowserVisibility": { "type": "string", "enum": ["headed", "headless"] },
          "pageCount": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/RuntimeStatus" }
        },
        "required": ["profileId", "browserVisibility", "effectiveBrowserVisibility", "pageCount", "status"],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "slug": { "$ref": "#/components/schemas/ProfileId" },
          "id": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "lifecycle": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "runtimeBinding": { "type": ["object", "null"] },
          "import": { "anyOf": [{ "$ref": "#/components/schemas/ProfileImport" }, { "type": "null" }] },
          "preferences": { "$ref": "#/components/schemas/ProfilePreferences" },
          "observations": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["slug", "id", "label", "lifecycle", "isDefault", "createdAt", "updatedAt", "runtimeBinding", "import", "preferences", "observations"],
        "additionalProperties": false
      },
      "ProfileImport": {
        "type": "object",
        "properties": {
          "browser": { "type": ["string", "null"] },
          "importedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["browser", "importedAt"],
        "additionalProperties": false
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string" },
          "profileId": { "type": ["string", "null"] },
          "profileSlug": { "anyOf": [{ "$ref": "#/components/schemas/ProfileId" }, { "type": "null" }] },
          "provider": { "type": "string" },
          "action": { "type": "string" },
          "status": { "type": "string" },
          "taskId": { "type": ["string", "null"] },
          "capabilityRoute": { "type": ["object", "null"] },
          "agent": { "type": ["object", "null"] },
          "blocker": {},
          "outputSavings": { "$ref": "#/components/schemas/JobOutputSavings" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["jobId", "profileId", "profileSlug", "provider", "action", "status", "taskId", "capabilityRoute", "agent", "blocker", "outputSavings", "createdAt", "updatedAt"],
        "additionalProperties": false
      },
      "JobDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/JobSummary" },
          {
            "type": "object",
            "properties": {
              "result": {},
              "error": {},
              "providerAttempts": {},
              "outputSavingsEvents": { "type": "array", "items": { "$ref": "#/components/schemas/OutputSavingsEvent" } }
            },
            "required": ["result", "error", "providerAttempts", "outputSavingsEvents"]
          }
        ]
      },
      "ProviderProfileState": {
        "type": "object",
        "properties": {
          "profileId": { "$ref": "#/components/schemas/ProfileId" },
          "enabled": { "type": "boolean" },
          "observation": { "type": ["object", "null"] },
          "runtimeEligibility": { "type": "string", "enum": ["eligible", "ineligible"] },
          "capabilities": { "type": "array", "items": { "type": "object" } },
          "controls": { "type": "object" }
        },
        "required": ["profileId", "enabled", "observation", "runtimeEligibility", "capabilities", "controls"],
        "additionalProperties": false
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/ProviderId" },
          "label": { "type": "string" },
          "stage": { "type": "string" },
          "homeUrl": { "type": "string", "format": "uri" },
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderProfileState" } }
        },
        "required": ["id", "label", "stage", "homeUrl", "profiles"],
        "additionalProperties": false
      },
      "Capability": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "family": { "type": "string" },
          "lifecycle": { "type": "string" },
          "stability": { "type": "string" },
          "requiredEvidence": { "type": "array", "items": { "type": "string" } },
          "providers": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["id", "title", "description", "family", "lifecycle", "stability", "requiredEvidence", "providers"],
        "additionalProperties": false
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string", "enum": ["ok", "action_required", "error"] },
          "message": { "type": ["string", "null"] }
        },
        "required": ["id", "state", "message"],
        "additionalProperties": false
      },
      "UiSnapshot": {
        "type": "object",
        "properties": {
          "schema": { "const": "tokenless.ui-snapshot.v1" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "string", "minLength": 1 },
          "daemon": { "$ref": "#/components/schemas/DaemonStatus" },
          "runtime": { "$ref": "#/components/schemas/RuntimeStatus" },
          "config": { "$ref": "#/components/schemas/UiConfig" },
          "outputSavings": { "$ref": "#/components/schemas/OutputSavingsState" },
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } },
          "providers": { "type": "array", "items": { "$ref": "#/components/schemas/Provider" } },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/Capability" } },
          "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/JobSummary" } },
          "diagnostics": { "type": "array", "items": { "$ref": "#/components/schemas/Diagnostic" } }
        },
        "required": ["schema", "generatedAt", "revision", "daemon", "runtime", "config", "outputSavings", "profiles", "providers", "capabilities", "jobs", "diagnostics"],
        "additionalProperties": false
      },
      "UiSession": {
        "type": "object",
        "properties": {
          "csrf": { "type": "string", "minLength": 32 },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["csrf", "expiresAt"],
        "additionalProperties": false
      },
      "ProfileRemoval": {
        "type": "object",
        "properties": { "slug": { "$ref": "#/components/schemas/ProfileId" }, "removed": { "const": true } },
        "required": ["slug", "removed"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "ConfigUpdate": {
        "type": "object",
        "properties": {
          "browser": { "type": "string" },
          "browserExecutablePath": { "type": ["string", "null"], "minLength": 1 },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "language": { "type": "string", "enum": ["en", "zh-CN"] }
        },
        "additionalProperties": false
      },
      "ProfileCreate": {
        "type": "object",
        "properties": {
          "slug": { "$ref": "#/components/schemas/ProfileId" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" },
          "setDefault": { "type": "boolean" },
          "importSourceId": { "type": "string", "format": "uuid" },
          "consentLocalProfileCopy": { "type": "boolean" }
        },
        "required": ["slug"],
        "additionalProperties": false
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" },
          "setDefault": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ProfileReimport": {
        "type": "object",
        "properties": {
          "consentLocalProfileCopy": { "const": true }
        },
        "required": ["consentLocalProfileCopy"],
        "additionalProperties": false
      },
      "ProviderSelection": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["model", "effort"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "required": ["kind", "label"],
        "additionalProperties": false
      }
    }
  }
}
