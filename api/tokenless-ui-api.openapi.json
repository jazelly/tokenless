{
  "openapi": "3.1.0",
  "info": {
    "title": "Tokenless Browser UI API",
    "version": "1.0.0",
    "description": "Authenticated, loopback-only API consumed by the bundled Tokenless control plane. Browser JavaScript never receives the daemon bearer token."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/ui-api/v1",
      "variables": { "port": { "default": "7331" } }
    }
  ],
  "security": [{ "uiSession": [] }],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getUiSession",
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "getUiSnapshot",
        "parameters": [
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Snapshot" },
          "304": { "description": "Snapshot revision is unchanged." },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/config": {
      "patch": {
        "operationId": "updateUiConfig",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ConfigUpdate" },
        "responses": {
          "200": { "$ref": "#/components/responses/Config" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/profiles": {
      "post": {
        "operationId": "createUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileCreate" },
        "responses": {
          "201": { "$ref": "#/components/responses/Profile" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/profiles/{profileId}": {
      "parameters": [{ "$ref": "#/components/parameters/ProfileId" }],
      "patch": {
        "operationId": "updateUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProfileUpdate" },
        "responses": { "200": { "$ref": "#/components/responses/Profile" }, "400": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "removeUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "responses": { "200": { "$ref": "#/components/responses/ProfileRemoval" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/open": {
      "post": {
        "operationId": "openUiProfile",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProfileId" }],
        "responses": { "200": { "$ref": "#/components/responses/RuntimeOpen" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/providers/{providerId}/actions/{action}": {
      "post": {
        "operationId": "runUiProviderAction",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProfileId" },
          { "$ref": "#/components/parameters/ProviderId" },
          { "name": "action", "in": "path", "required": true, "schema": { "type": "string", "enum": ["open", "readiness", "controls"] } }
        ],
        "responses": { "202": { "$ref": "#/components/responses/JobSummary" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/profiles/{profileId}/providers/{providerId}/selection": {
      "post": {
        "operationId": "selectUiProviderControl",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProfileId" },
          { "$ref": "#/components/parameters/ProviderId" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ProviderSelection" },
        "responses": { "202": { "$ref": "#/components/responses/JobSummary" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getUiJob",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/cancel": {
      "post": {
        "operationId": "cancelUiJob",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/resume": {
      "post": {
        "operationId": "resumeUiJob",
        "security": [{ "uiSession": [], "csrf": [] }],
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "$ref": "#/components/responses/JobDetail" }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/runtime/quiesce": {
      "post": {
        "operationId": "quiesceUiRuntime",
        "security": [{ "uiSession": [], "csrf": [] }],
        "responses": { "200": { "$ref": "#/components/responses/RuntimeOperation" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "uiSession": { "type": "apiKey", "in": "cookie", "name": "tokenless_ui_session" },
      "csrf": { "type": "apiKey", "in": "header", "name": "X-Tokenless-CSRF" }
    },
    "parameters": {
      "ProfileId": { "name": "profileId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ProfileId" } },
      "ProviderId": { "name": "providerId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ProviderId" } },
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "requestBodies": {
      "ConfigUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigUpdate" } } } },
      "ProfileCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileCreate" } } } },
      "ProfileUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileUpdate" } } } },
      "ProviderSelection": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderSelection" } } } }
    },
    "responses": {
      "Session": { "description": "Active in-memory UI session.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiSession" } } } },
      "Snapshot": { "description": "Redacted aggregate dashboard state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiSnapshot" } } } },
      "Config": { "description": "Persisted public configuration.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiConfig" } } } },
      "Profile": { "description": "Purpose-built managed profile view.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } },
      "ProfileRemoval": { "description": "Profile removal acknowledgement.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileRemoval" } } } },
      "JobSummary": { "description": "Redacted durable job summary.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobSummary" } } } },
      "JobDetail": { "description": "Redacted durable job detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobDetail" } } } },
      "RuntimeOpen": { "description": "Managed profile browser open result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeOpenResult" } } } },
      "RuntimeOperation": { "description": "Browser runtime operation result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeStatus" } } } },
      "Error": { "description": "Redacted error envelope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "ProfileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "ProviderId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "BrowserVisibility": { "type": "string", "enum": ["auto", "headed", "headless"] },
      "Proxy": {
        "type": ["object", "null"],
        "properties": {
          "server": { "type": "string", "format": "uri", "pattern": "^(?:https?|socks5)://" },
          "bypass": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["server", "bypass"],
        "additionalProperties": false
      },
      "ProfilePreferences": {
        "type": "object",
        "properties": {
          "profileId": { "$ref": "#/components/schemas/ProfileId" },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" }
        },
        "required": ["profileId", "roleLabel", "enabledProviders", "browserVisibility", "proxy"],
        "additionalProperties": false
      },
      "UiConfig": {
        "type": "object",
        "properties": {
          "updatedAt": { "type": ["string", "null"], "format": "date-time" },
          "browser": { "type": "string" },
          "browserConnectionMode": { "type": "string", "enum": ["playwright", "cdp"] },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "daemonUrl": { "type": ["string", "null"], "format": "uri" },
          "language": { "type": "string", "enum": ["en", "zh-CN"] }
        },
        "required": ["updatedAt", "browser", "browserConnectionMode", "browserVisibility", "daemonUrl", "language"],
        "additionalProperties": false
      },
      "RuntimeStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "activeProfileCount": { "type": "integer", "minimum": 0 },
          "activeJobCount": { "type": "integer", "minimum": 0 },
          "pid": { "type": "integer", "minimum": 1 }
        },
        "required": ["status", "activeProfileCount", "activeJobCount", "pid"],
        "additionalProperties": true
      },
      "DaemonStatus": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "origin": { "type": "string", "format": "uri" },
          "uptimeMs": { "type": "integer", "minimum": 0 },
          "pid": { "type": "integer", "minimum": 1 }
        },
        "required": ["version", "origin", "uptimeMs", "pid"],
        "additionalProperties": false
      },
      "RuntimeOpenResult": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "format": "uuid" },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "effectiveBrowserVisibility": { "type": "string", "enum": ["headed", "headless"] },
          "pageCount": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/RuntimeStatus" }
        },
        "required": ["profileId", "browserVisibility", "effectiveBrowserVisibility", "pageCount", "status"],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "slug": { "$ref": "#/components/schemas/ProfileId" },
          "id": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "lifecycle": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "runtimeBinding": { "type": ["object", "null"] },
          "import": { "type": ["object", "null"] },
          "preferences": { "$ref": "#/components/schemas/ProfilePreferences" },
          "observations": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["slug", "id", "label", "lifecycle", "isDefault", "createdAt", "updatedAt", "runtimeBinding", "import", "preferences", "observations"],
        "additionalProperties": false
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string" },
          "profileId": { "type": ["string", "null"] },
          "profileSlug": { "anyOf": [{ "$ref": "#/components/schemas/ProfileId" }, { "type": "null" }] },
          "provider": { "type": "string" },
          "action": { "type": "string" },
          "status": { "type": "string" },
          "taskId": { "type": ["string", "null"] },
          "capabilityRoute": { "type": ["object", "null"] },
          "agent": { "type": ["object", "null"] },
          "blocker": {},
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["jobId", "profileId", "profileSlug", "provider", "action", "status", "taskId", "capabilityRoute", "agent", "blocker", "createdAt", "updatedAt"],
        "additionalProperties": false
      },
      "JobDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/JobSummary" },
          {
            "type": "object",
            "properties": { "result": {}, "error": {}, "providerAttempts": {} },
            "required": ["result", "error", "providerAttempts"]
          }
        ]
      },
      "ProviderProfileState": {
        "type": "object",
        "properties": {
          "profileId": { "$ref": "#/components/schemas/ProfileId" },
          "enabled": { "type": "boolean" },
          "observation": { "type": ["object", "null"] },
          "runtimeEligibility": { "type": "string", "enum": ["eligible", "ineligible"] },
          "capabilities": { "type": "array", "items": { "type": "object" } },
          "controls": { "type": "object" }
        },
        "required": ["profileId", "enabled", "observation", "runtimeEligibility", "capabilities", "controls"],
        "additionalProperties": false
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/ProviderId" },
          "label": { "type": "string" },
          "stage": { "type": "string" },
          "homeUrl": { "type": "string", "format": "uri" },
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderProfileState" } }
        },
        "required": ["id", "label", "stage", "homeUrl", "profiles"],
        "additionalProperties": false
      },
      "Capability": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "family": { "type": "string" },
          "lifecycle": { "type": "string" },
          "stability": { "type": "string" },
          "requiredEvidence": { "type": "array", "items": { "type": "string" } },
          "providers": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["id", "title", "description", "family", "lifecycle", "stability", "requiredEvidence", "providers"],
        "additionalProperties": false
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string", "enum": ["ok", "action_required", "error"] },
          "message": { "type": ["string", "null"] }
        },
        "required": ["id", "state", "message"],
        "additionalProperties": false
      },
      "UiSnapshot": {
        "type": "object",
        "properties": {
          "schema": { "const": "tokenless.ui-snapshot.v1" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "string", "minLength": 1 },
          "daemon": { "$ref": "#/components/schemas/DaemonStatus" },
          "runtime": { "$ref": "#/components/schemas/RuntimeStatus" },
          "config": { "$ref": "#/components/schemas/UiConfig" },
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } },
          "providers": { "type": "array", "items": { "$ref": "#/components/schemas/Provider" } },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/Capability" } },
          "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/JobSummary" } },
          "diagnostics": { "type": "array", "items": { "$ref": "#/components/schemas/Diagnostic" } }
        },
        "required": ["schema", "generatedAt", "revision", "daemon", "runtime", "config", "profiles", "providers", "capabilities", "jobs", "diagnostics"],
        "additionalProperties": false
      },
      "UiSession": {
        "type": "object",
        "properties": {
          "csrf": { "type": "string", "minLength": 32 },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["csrf", "expiresAt"],
        "additionalProperties": false
      },
      "ProfileRemoval": {
        "type": "object",
        "properties": { "slug": { "$ref": "#/components/schemas/ProfileId" }, "removed": { "const": true } },
        "required": ["slug", "removed"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "ConfigUpdate": {
        "type": "object",
        "properties": {
          "browser": { "type": "string" },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "language": { "type": "string", "enum": ["en", "zh-CN"] }
        },
        "additionalProperties": false
      },
      "ProfileCreate": {
        "type": "object",
        "properties": {
          "slug": { "$ref": "#/components/schemas/ProfileId" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" },
          "setDefault": { "type": "boolean" }
        },
        "required": ["slug"],
        "additionalProperties": false
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "roleLabel": { "type": "string", "maxLength": 80 },
          "enabledProviders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/components/schemas/ProviderId" } },
          "browserVisibility": { "$ref": "#/components/schemas/BrowserVisibility" },
          "proxy": { "$ref": "#/components/schemas/Proxy" },
          "setDefault": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ProviderSelection": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["model", "effort"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "required": ["kind", "label"],
        "additionalProperties": false
      }
    }
  }
}
