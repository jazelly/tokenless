{
  "openapi": "3.1.0",
  "info": {
    "title": "Tokenless daemon HTTP API",
    "version": "1.0.0",
    "description": "Local loopback daemon HTTP API. Every daemon route, readiness proof, error envelope, job payload, and browser runtime control response belongs to this OpenAPI contract."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7331",
      "description": "Preferred loopback origin. The daemon may bind a higher free port and records the actual origin in local SQLite runtime state."
    }
  ],
  "security": [
    {
      "controlBearer": []
    }
  ],
  "paths": {
    "/ready": {
      "get": {
        "operationId": "getReady",
        "summary": "Read token-bound daemon readiness proof without auth",
        "security": [],
        "parameters": [
          {
            "name": "challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daemon readiness proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/browser-runtime/status": {
      "get": {
        "operationId": "getBrowserRuntimeStatus",
        "summary": "Read embedded browser runtime status",
        "responses": {
          "200": {
            "description": "Browser runtime status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserRuntimeStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/browser-runtime/quiesce": {
      "post": {
        "operationId": "quiesceBrowserRuntime",
        "summary": "Quiesce the embedded browser runtime",
        "responses": {
          "200": {
            "description": "Browser runtime status after quiesce request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserRuntimeStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/browser-runtime/open-profile": {
      "post": {
        "operationId": "openBrowserRuntimeProfile",
        "summary": "Open a managed profile in the embedded browser runtime without provider navigation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenBrowserRuntimeProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Opened managed profile runtime status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenBrowserRuntimeProfileResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/provider-mappings/resolve": {
      "get": {
        "operationId": "resolveProviderProjectMapping",
        "summary": "Resolve an exact provider Project and optional task conversation mapping",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "project_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          {
            "name": "task_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact provider Project mapping, with a task-scoped conversation when requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderMappingResolveResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/provider-conversations/resolve": {
      "get": {
        "operationId": "resolveProviderTaskConversation",
        "summary": "Resolve a provider conversation by exact profile and task scope",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "task_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact provider task conversation mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTaskConversationResolveResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List public job views",
        "parameters": [
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/execution_backend"
          },
          {
            "$ref": "#/components/parameters/profile_id"
          },
          {
            "$ref": "#/components/parameters/provider"
          },
          {
            "$ref": "#/components/parameters/task_id"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobView"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createJob",
        "summary": "Create a job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Read a public job view",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/resume": {
      "post": {
        "operationId": "resumeJob",
        "summary": "Resume a parked Playwright job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/control/shutdown": {
      "post": {
        "operationId": "shutdownDaemon",
        "summary": "Request graceful daemon shutdown using bearer authentication",
        "security": [
          {
            "controlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Shutdown accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShutdownResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Shutdown route is not mounted by runtimes that use http_router(store); Axum may return its default 404 body."
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "summary": "Cancel an active job",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PublicJob"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/jobs/{job_id}/report": {
      "post": {
        "operationId": "reportJobOutcome",
        "summary": "Mark one addressed job outcome revision as reported",
        "parameters": [
          {
            "$ref": "#/components/parameters/job_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRecipientRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent report receipt and public job view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/replay/drain": {
      "post": {
        "operationId": "drainAgentReplay",
        "summary": "Atomically report pending outcome summaries for one agent recipient",
        "description": "Eligible outcome revisions are marked reported in SQLite before this response is returned. A lost response is not replayed automatically; full job state remains queryable by job ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayDrainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Newly reported outcome summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayDrainResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token read from the daemon home control token file. /ready is a public challenge endpoint; /control/shutdown uses bearer authentication after the CLI verifies /ready for the same home."
      }
    },
    "parameters": {
      "job_id": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/JobStatus"
        }
      },
      "execution_backend": {
        "name": "execution_backend",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/ExecutionBackend"
        }
      },
      "profile_id": {
        "name": "profile_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "provider": {
        "name": "provider",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "task_id": {
        "name": "task_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "action": {
        "name": "action",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      }
    },
    "responses": {
      "PublicJob": {
        "description": "Public job view",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JobView"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request body, path, query, or daemon input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Rejected bearer token or claim token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Job or routed endpoint not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Claim lease or job state conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Daemon internal failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DaemonErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "DaemonErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "ReadyResponse": {
        "type": "object",
        "required": [
          "version",
          "ready",
          "home_dir",
          "pid",
          "proof"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "ready": {
            "const": true
          },
          "home_dir": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "proof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "BrowserRuntimeStatus": {
        "type": "object",
        "required": [
          "status",
          "activeProfileCount",
          "activeJobCount",
          "pid"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "running",
              "quiescing",
              "quiesced",
              "stopped"
            ]
          },
          "activeProfileCount": {
            "type": "integer",
            "minimum": 0
          },
          "activeJobCount": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "BrowserVisibility": {
        "enum": [
          "auto",
          "headed",
          "headless"
        ]
      },
      "EffectiveBrowserVisibility": {
        "enum": [
          "headed",
          "headless"
        ]
      },
      "OpenBrowserRuntimeProfileRequest": {
        "type": "object",
        "required": [
          "profile_id",
          "browser_visibility"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "browser_visibility": {
            "$ref": "#/components/schemas/BrowserVisibility"
          }
        }
      },
      "OpenBrowserRuntimeProfileResponse": {
        "type": "object",
        "required": [
          "profileId",
          "browserVisibility",
          "effectiveBrowserVisibility",
          "pageCount",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "profileId": {
            "type": "string",
            "minLength": 1
          },
          "browserVisibility": {
            "$ref": "#/components/schemas/BrowserVisibility"
          },
          "effectiveBrowserVisibility": {
            "$ref": "#/components/schemas/EffectiveBrowserVisibility"
          },
          "pageCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/BrowserRuntimeStatus"
          }
        }
      },
      "ExecutionBackend": {
        "enum": [
          "playwright"
        ]
      },
      "JobStatus": {
        "enum": [
          "queued",
          "claimed",
          "running",
          "waiting_for_user",
          "succeeded",
          "failed",
          "canceled",
          "timed_out"
        ]
      },
      "JobView": {
        "type": "object",
        "required": [
          "job_id",
          "execution_backend",
          "profile_id",
          "provider",
          "action",
          "status",
          "request_json",
          "result_json",
          "error_json",
          "blocker_json",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_backend": {
            "$ref": "#/components/schemas/ExecutionBackend"
          },
          "profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "request_json": {},
          "result_json": {},
          "error_json": {},
          "blocker_json": {},
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProviderProjectMapping": {
        "type": "object",
        "required": [
          "provider",
          "profile_id",
